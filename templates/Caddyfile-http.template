{
	storage file_system {
		root /data/caddy
	}

	auto_https off
}

http://127.0.0.1:${PRIVATE_HEALTHCHECK_PORT} {
	bind 127.0.0.1
	handle /health {
		reverse_proxy /health 127.0.0.1:${PRIVATE_HEADSCALE_LISTEN_PORT}
	}
	handle {
		respond 404
	}
}

http://:${PUBLIC_LISTEN_PORT} {
	# Tailscale captive portal detection
	handle /generate_204 {
		respond 204
	}

	redir /admin /admin/

	handle /admin/* {
		root * /admin-gui
		encode gzip zstd

		@admin_assets path_regexp admin_assets ^/admin/.*\.[^/]+$
		handle @admin_assets {
			file_server${SECURITY_HEADERS_BLOCK}
		}

		@admin_navigation {
			header Accept *text/html*
			not path_regexp admin_navigation_assets ^/admin/.*\.[^/]+$
		}
		handle @admin_navigation {
			try_files {path}.html {path} {path}/index.html /admin/200.html
			file_server${SECURITY_HEADERS_BLOCK}
		}
		file_server${SECURITY_HEADERS_BLOCK}
	}

	handle {
		reverse_proxy 127.0.0.1:${PRIVATE_HEADSCALE_LISTEN_PORT} {
			header_up True-Client-IP {remote_host}
			header_up X-Real-IP {remote_host}
		}${SECURITY_HEADERS_BLOCK}
	}
}
