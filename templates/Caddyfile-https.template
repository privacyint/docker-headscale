{
	storage file_system {
		root /data/caddy
	}

	email ${ACME_ISSUANCE_EMAIL}

	${ACME_EAB_BLOCK}
	${ECH_BLOCK}
}

http://127.0.0.1:${PRIVATE_HEALTHCHECK_PORT} {
	handle /health {
		reverse_proxy /health 127.0.0.1:${PRIVATE_HEADSCALE_LISTEN_PORT}
	}
	handle {
		respond 404
	}
}

${PUBLIC_SERVER_URL}:${PUBLIC_LISTEN_PORT} {
	# Tailscale captive portal detection
	handle /generate_204 {
		respond 204
	}

	redir /admin /admin/

	handle /admin/* {
		root * /admin-gui
		encode gzip zstd

		@admin_asset path_regexp admin_asset ^/admin/.*\.[^/]+$
		handle @admin_asset {
			file_server${SECURITY_HEADERS_BLOCK}
		}

		@admin_existing file {
			try_files {path}.html {path} {path}/index.html
		}
		handle @admin_existing {
			rewrite * {file_match.relative}
			file_server${SECURITY_HEADERS_BLOCK}
		}

		@admin_html header Accept *text/html*
		handle @admin_html {
			rewrite * /admin/200.html
			file_server${SECURITY_HEADERS_BLOCK}
		}
		file_server${SECURITY_HEADERS_BLOCK}
	}

	handle {
		reverse_proxy 127.0.0.1:${PRIVATE_HEADSCALE_LISTEN_PORT} {
			header_up True-Client-IP {remote_host}
			header_up X-Real-IP {remote_host}
		}${SECURITY_HEADERS_BLOCK}
	}

	${CLOUDFLARE_ACME_BLOCK}
}
